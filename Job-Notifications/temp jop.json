    {
      "parameters": {
        "jsCode": "const data = items[0].json; // اضبط حسب الـ output لديك\nconst titles = data.job_title || [];\nconst links = data.job_link || [];\nconst companies = data.company || data.Company || [];\nconst locations = data.location || [];\nconst posted = data.posted_ago || [];\n\nlet messages = [];\nlet minLen = Math.min(titles.length, links.length, companies.length, locations.length);\n\n// تكوين كل بند كنص منفصل\nlet outputArr = [];\n\nfor (let i = 0; i < minLen; i++) {\n  let fullLink = links[i] ? (links[i].startsWith('http') ? links[i] : `https://wuzzuf.net${links[i]}`) : \"\";\n  outputArr.push(\n    `🔹 *${titles[i]}*\\n🏢 ${companies[i] || ''} | 📍 ${locations[i] || ''}\\n🕒 ${posted[i] ? posted[i] : ''}\\n🔗 ${fullLink}\\n`\n  );\n}\n\n// دمج البندات في رسائل لا تتعدى 2000 حرف\nlet currentMsg = '';\noutputArr.forEach(line => {\n  if ((currentMsg + line).length > 2000) {\n    messages.push({ json: { message: currentMsg } });\n    currentMsg = line;\n  } else {\n    currentMsg += (currentMsg ? '\\n' : '') + line;\n  }\n});\nif(currentMsg) messages.push({ json: { message: currentMsg } });\n\n// لو تريد فقط 3 رسائل بالضبط\nif(messages.length > 3){\n   messages = messages.slice(0,3);\n}\n\nreturn messages;\n"
      },
