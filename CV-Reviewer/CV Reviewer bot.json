    {
      "parameters": {
        "jsCode": "const report = $json.output;\n\nfunction extractScore(label) {\n  const regex = new RegExp(`${label}:\\\\s*(\\\\d+)`);\n  const match = report.match(regex);\n  return match ? Number(match[1]) : null;\n}\n\nreturn [\n  {\n    json: {\n      report,\n\n      overall_score: extractScore(\"OVERALL_SCORE\"),\n      ats_score: extractScore(\"ATS_SCORE\"),\n      recruiter_score: extractScore(\"RECRUITER_SCORE\"),\n      technical_score: extractScore(\"TECHNICAL_SCORE\"),\n      completeness_score: extractScore(\"COMPLETENESS_SCORE\"),\n\n      discord_username: $('Google Sheets Trigger').item.json['Discord Username'],\n      discord_user_id: $('Google Sheets Trigger').item.json['Discord User ID']\n    }\n  }\n];"
      },
