      "parameters": {
        "jsCode": "const today = new Date().toLocaleDateString();\n\nlet msg = `🚀 Devora Daily AI Digest\\n`;\nmsg += `📅 ${today}\\n\\n`;\n\nlet count = 1;\n\nfor (const item of items.slice(0, 3)) {\n\n  const title = item.json.title || \"\";\n\n  const desc = (item.json.contentSnippet || \"\")\n    .replace(/<[^>]*>/g, \"\")\n    .substring(0, 80);\n\n  msg += `📰 ${count}. ${title}\\n`;\n  msg += `📌 ${desc}...\\n`;\n  msg += `🔗 ${item.json.link}\\n\\n`;\n\n  count++;\n}\n\nmsg += \"━━━━━━━━━━━━━━\\n\";\nmsg += \"🤖 Devora AI Bot\";\n\nreturn [\n  {\n    json: {\n      message: msg\n    }\n  }\n];"
